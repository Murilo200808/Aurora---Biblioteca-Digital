<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BiblioTemp | Catálogo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600&family=Spectral:wght@600;700&display=swap" rel="stylesheet">
  <link href="style.css" rel="stylesheet">
</head>
<body>

  <header class="site-header">
    <nav class="navbar navbar-expand-md navbar-dark">
      <div class="container">
        <a class="navbar-brand logo" href="index.html"><span class="logo-marca">B</span> BiblioTemp</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#menuPrincipal" aria-label="Abrir menu">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menuPrincipal">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item"><a class="nav-link" href="index.html">Início</a></li>
            <li class="nav-item"><a class="nav-link active" href="catalogo.html">Catálogo em destaque</a></li>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <main class="container py-5">
    <h1 class="titulo-pagina">Catálogo em destaque</h1>
    <p class="texto-suave">Livros selecionados pela biblioteca. Use a busca para filtrar.</p>

    <section class="busca-caixa mb-4" aria-label="Busca de livros">
      <div class="row g-3">

        <div class="col-md-6">
          <label for="busca-texto" class="form-label">Buscar</label>
          <input type="search" id="busca-texto" class="form-control" placeholder="Digite um nome, autor ou categoria">
        </div>

        <div class="col-md-3">
          <label for="busca-campo" class="form-label">Buscar por</label>
          <select id="busca-campo" class="form-select">
            <option value="todos">Todos os campos</option>
            <option value="titulo">Nome do livro</option>
            <option value="autor">Autor</option>
            <option value="categoria">Categoria</option>
          </select>
        </div>

        <div class="col-md-3">
          <label for="busca-categoria" class="form-label">Categoria</label>
          <select id="busca-categoria" class="form-select">
            <option value="">Todas</option>
          </select>
        </div>
      </div>
    </section>

    <p id="contador" class="texto-suave" aria-live="polite"></p>

    <div class="row g-4" id="lista-catalogo"></div>

    <div id="sem-resultados" class="alert alert-light border d-none">
      Nenhum livro encontrado. Tente outro termo ou escolha "Todas" em categoria.
    </div>
  </main>

  <footer class="site-footer">
    <div class="container py-4">BiblioTemp — protótipo · nome provisório</div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="data.js"></script>
  <script src="main.js"></script>
</body>
</html>
