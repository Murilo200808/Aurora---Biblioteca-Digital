<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Aurora | Biblioteca pública digital</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">

  <link href="style.css" rel="stylesheet">
</head>
<body>

  <header class="site-header">
    <nav class="navbar navbar-expand-md">
      <div class="pad-x w-100 d-flex align-items-center flex-wrap">

        <a class="navbar-brand logo" href="#inicio" aria-label="Aurora, início">
          <span class="logo-marca">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5z"/><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H19v-3"/><path d="M9 8h6"/></svg>
          </span>
          Aurora
        </a>

        <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse"
                data-bs-target="#menuPrincipal" aria-label="Abrir menu">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menuPrincipal">
          <ul class="navbar-nav mx-auto">
            <li class="nav-item"><a class="nav-link active" href="#inicio">Início</a></li>
            <li class="nav-item"><a class="nav-link" href="#acervo">Acervo</a></li>
          </ul>
          <div class="header-acoes">
            <a href="#acervo" class="btn-icone" id="btn-buscar" aria-label="Buscar no acervo">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </a>
            <button type="button" class="btn-contorno" id="btn-entrar" data-bs-toggle="modal" data-bs-target="#modalLogin" data-modo="login">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
              Entrar
            </button>

            <div class="usuario-area d-none" id="usuario-area">
              <button type="button" class="btn-perfil" id="btn-perfil" data-bs-toggle="modal" data-bs-target="#modalPerfil" aria-label="Abrir meu perfil">
                <span class="perfil-avatar" id="perfil-avatar" aria-hidden="true"></span>
                <span class="usuario-nome" id="usuario-nome"></span>
              </button>
              <button type="button" class="btn-contorno" id="btn-sair">Sair</button>
            </div>
          </div>
        </div>
      </div>
    </nav>
  </header>

  <main>

    <section class="hero" id="inicio">
      <div class="pad-x hero-corpo">
        <div class="row align-items-center gy-5">
          <div class="col-lg-7">
            <p class="eyebrow eyebrow-claro">Biblioteca pública digital</p>
            <h1 class="hero-titulo">Histórias que ficam com você.</h1>
            <p class="hero-texto">Milhares de livros, novas descobertas e um lugar feito para quem acredita no poder da leitura.</p>
            <a href="#acervo" class="btn-claro">
              Explorar o acervo
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>

          <div class="col-lg-5">
            <div class="hero-arte" id="hero-arte">
              <figure class="hero-citacao">
                <span class="aspas" aria-hidden="true">“</span>
                <blockquote>"Sempre imaginei que o paraíso fosse uma espécie de biblioteca."</blockquote>
                <figcaption>— Jorge Luis Borges</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-numeros">
        <div class="pad-x d-flex flex-wrap gap-4 gap-md-5">
          <div><strong>12 mil</strong><span>Títulos disponíveis</span></div>
          <div><strong>3.200</strong><span>Leitores ativos</span></div>
          <div><strong>24h</strong><span>Acervo digital</span></div>
        </div>
      </div>
    </section>

    <section class="acervo" id="acervo">
      <div class="pad-x">
        <div class="acervo-topo">
          <div>
            <p class="eyebrow">Nosso acervo</p>
            <h2 class="acervo-titulo">Catálogo de livros</h2>
          </div>

          <div class="acervo-controles">
            <label class="busca" for="busca-texto">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              <input type="search" id="busca-texto" placeholder="Busque por título ou autor" autocomplete="off">
            </label>
            <button type="button" class="btn-seta" id="seta-anterior" aria-label="Livros anteriores">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
            </button>
            <button type="button" class="btn-seta" id="seta-proximo" aria-label="Próximos livros">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
            </button>
          </div>
        </div>

        <p class="acervo-contador" id="contador" aria-live="polite"></p>
        <hr class="acervo-linha">
      </div>

      <div class="pad-x-esq">
        <div class="carrossel" id="lista-catalogo" tabindex="0" aria-label="Lista de livros"></div>
      </div>

      <div class="pad-x">
        <div class="progresso">
          <div class="progresso-trilho"><div class="progresso-barra" id="progresso-barra"></div></div>
          <span id="progresso-texto">01 / 08</span>
        </div>

        <p id="sem-resultados" class="sem-resultados d-none">Nenhum livro encontrado. Tente outro título ou autor.</p>
      </div>
    </section>

    <section class="convite">
      <div class="pad-x convite-corpo">
        <div>
          <p class="eyebrow">Um convite diário</p>
          <h2 class="convite-titulo">Há sempre uma nova história à sua espera.</h2>
        </div>
        <button type="button" class="btn-escuro" data-bs-toggle="modal" data-bs-target="#modalLogin" data-modo="cadastro" id="btn-criar-conta">
          <span id="convite-rotulo">Criar minha conta</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="pad-x rodape-corpo">
      <a class="logo logo-rodape" href="#inicio">
        <span class="logo-marca logo-marca-escura">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5z"/><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H19v-3"/></svg>
        </span>
        Aurora
      </a>
      <p class="rodape-lema">Biblioteca para todos. Conhecimento sem fronteiras.</p>
      <p class="rodape-direitos">© 2026 Aurora</p>
    </div>
  </footer>

  <div class="modal fade" id="modalLogin" tabindex="-1" aria-labelledby="loginTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content login">
        <button type="button" class="login-fechar" data-bs-dismiss="modal" aria-label="Fechar">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>

        <span class="logo-marca logo-marca-escura login-logo">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5z"/><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H19v-3"/></svg>
        </span>

        <p class="eyebrow eyebrow-laranja">Área do leitor</p>
        <h2 class="login-titulo" id="loginTitulo">Entre na sua conta</h2>
        <p class="login-texto" id="login-texto">Acompanhe reservas, renovações e suas listas de leitura.</p>

        <form id="form-login" novalidate>

          <div id="grupo-nome" class="d-none">
            <label class="login-rotulo" for="login-nome">Nome</label>
            <div class="campo">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
              <input type="text" id="login-nome" placeholder="Seu nome" autocomplete="name" maxlength="60">
            </div>
          </div>

          <label class="login-rotulo" for="login-email">E-mail</label>
          <div class="campo">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <input type="email" id="login-email" placeholder="voce@exemplo.com" autocomplete="email" required>
          </div>

          <label class="login-rotulo" for="login-senha">Senha</label>
          <div class="campo">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            <input type="password" id="login-senha" placeholder="Sua senha" autocomplete="current-password" required>
            <button type="button" class="campo-olho" id="ver-senha" aria-label="Mostrar senha">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <p class="campo-dica d-none" id="dica-senha">Use pelo menos 8 caracteres.</p>

          <div class="login-linha">
            <label class="lembrar"><input type="checkbox" id="login-lembrar"> Lembrar de mim</label>
            <a href="#" class="link-laranja" id="link-esqueci">Esqueci minha senha</a>
          </div>

          <p class="login-erro d-none" id="login-erro" role="alert"></p>

          <button type="submit" class="btn-escuro btn-bloco" id="login-enviar">
            <span id="login-enviar-texto">Entrar</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </form>

        <p class="login-rodape"><span id="login-rodape-texto">Ainda não tem cadastro?</span> <a href="#" class="link-laranja" id="link-trocar-modo">Criar conta</a></p>
      </div>
    </div>
  </div>

  <div class="modal fade" id="modalLivro" tabindex="-1" aria-labelledby="detalhe-titulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-livro">
      <div class="modal-content detalhe">
        <button type="button" class="login-fechar detalhe-fechar" data-bs-dismiss="modal" aria-label="Fechar">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>

        <div class="detalhe-arte" id="detalhe-arte">
          <img id="detalhe-capa" alt="">
        </div>

        <div class="detalhe-info">
          <span class="detalhe-status" id="detalhe-status"></span>
          <p class="eyebrow eyebrow-laranja mb-2" id="detalhe-categoria"></p>
          <h2 class="detalhe-titulo" id="detalhe-titulo"></h2>
          <p class="detalhe-autor" id="detalhe-autor"></p>

          <dl class="detalhe-dados">
            <div><dt>Publicação</dt><dd id="detalhe-ano"></dd></div>
            <div><dt>Extensão</dt><dd id="detalhe-paginas"></dd></div>
            <div><dt>Empréstimo</dt><dd id="detalhe-dias"></dd></div>
          </dl>

          <p class="detalhe-rotulo">Sobre o livro</p>
          <p class="detalhe-texto" id="detalhe-sinopse"></p>
          <blockquote class="detalhe-citacao d-none" id="detalhe-citacao"></blockquote>

          <p class="login-erro d-none" id="detalhe-erro" role="alert"></p>
          <button type="button" class="btn-escuro btn-bloco" id="btn-reservar">
            <span id="btn-reservar-texto">Reservar este livro</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="modalPerfil" tabindex="-1" aria-labelledby="perfil-titulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-perfil">
      <div class="modal-content perfil">
        <button type="button" class="login-fechar" data-bs-dismiss="modal" aria-label="Fechar">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>

        <div class="perfil-topo">
          <span class="perfil-avatar perfil-avatar-grande" id="perfil-avatar-grande" aria-hidden="true"></span>
          <div>
            <p class="eyebrow eyebrow-laranja mb-1">Meu perfil</p>
            <h2 class="perfil-nome" id="perfil-titulo"></h2>
            <p class="perfil-email" id="perfil-email"></p>
          </div>
        </div>

        <div class="perfil-abas" role="tablist">
          <button type="button" class="perfil-aba ativo" role="tab" data-aba="favoritos" aria-selected="true">Favoritos <span class="perfil-conta" id="conta-favoritos">0</span></button>
          <button type="button" class="perfil-aba" role="tab" data-aba="emprestados" aria-selected="false">Emprestados <span class="perfil-conta" id="conta-emprestados">0</span></button>
        </div>

        <div class="perfil-painel" id="painel-favoritos" role="tabpanel"></div>
        <div class="perfil-painel d-none" id="painel-emprestados" role="tabpanel"></div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <script src="data.js"></script>
  <script src="firebase-config.js"></script>
  <script src="main.js"></script>
</body>
</html>
